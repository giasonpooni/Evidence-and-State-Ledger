[Unit]
Description=One evidence-retained industrial source refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=notation
Group=notation
UMask=0077
WorkingDirectory=/opt/notation/esm
ExecStartPre=/usr/bin/node /opt/notation/esm/.stamp/industrial-operations.mjs doctor /etc/notation/industrial-operations.json collector
ExecStart=/usr/bin/node /opt/notation/esm/.stamp/industrial-operations.mjs refresh /etc/notation/industrial-operations.json
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
StateDirectory=notation/industrial-operations
ReadOnlyPaths=/opt/notation/esm /opt/notation/gsc /etc/notation
ReadWritePaths=/var/lib/notation/industrial-operations
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NEXT_TELEMETRY_DISABLED=1
